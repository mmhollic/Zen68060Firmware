BANK 0 VCCIO 3.3 V;
BANK 1 VCCIO 3.3 V;
BANK 2 VCCIO 3.3 V;
BANK 3 VCCIO 3.3 V;
BANK 4 VCCIO 3.3 V;
BANK 5 VCCIO 3.3 V;
BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;
IOBUF PORT "RAM_CS_N" IO_TYPE=LVCMOS25 SLEWRATE=FAST ;
IOBUF PORT "RW_IN" IO_TYPE=LVCMOS25 ;
IOBUF PORT "TS_N" IO_TYPE=LVCMOS25 ;
IOBUF PORT "CLK" IO_TYPE=LVCMOS25 ;
IOBUF PORT "A[23]" IO_TYPE=LVCMOS25 ;
IOBUF PORT "A[24]" IO_TYPE=LVCMOS25 ;
IOBUF PORT "A[25]" IO_TYPE=LVCMOS25 ;
IOBUF PORT "A[26]" IO_TYPE=LVCMOS25 ;
IOBUF PORT "A[27]" IO_TYPE=LVCMOS25 ;
IOBUF PORT "A[28]" IO_TYPE=LVCMOS25 ;
IOBUF PORT "RST" IO_TYPE=LVCMOS25 ;
IOBUF PORT "A[29]" IO_TYPE=LVCMOS25 ;
IOBUF PORT "TA_N" IO_TYPE=LVCMOS25 SLEWRATE=FAST ;
IOBUF PORT "A[30]" IO_TYPE=LVCMOS25 ;
IOBUF PORT "A[31]" IO_TYPE=LVCMOS25 ;
IOBUF PORT "RW_OUT" IO_TYPE=LVCMOS25 ;
IOBUF PORT "RAM_OE_N" IO_TYPE=LVCMOS25 SLEWRATE=FAST ;
IOBUF PORT "LOCK" IO_TYPE=LVCMOS25 ;
IOBUF PORT "ROM_CS_N" IO_TYPE=LVCMOS25 SLEWRATE=FAST ;
FREQUENCY NET "CLK_c" 50.000000 MHz ;
FREQUENCY NET "CLKOS" 200.000000 MHz ;
FREQUENCY NET "u_ZenPLL/CLKOP" 50.000000 MHz ;
FREQUENCY NET "CLKOS2" 100.000000 MHz ;
CLOCK_TO_OUT PORT "RAM_CS_N" 6.000000 ns CLKPORT "CLK" ;
VCCIO_DERATE PERCENT 0; 
