BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;
IOBUF PORT "CLK" IO_TYPE=LVCMOS33 ;
IOBUF PORT "RESET_PLL" IO_TYPE=LVCMOS33 ;
IOBUF PORT "RW_IN" IO_TYPE=LVCMOS33 ;
IOBUF PORT "LOCK_PLL" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "RAM_CS_N" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "RAM_OE_N" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "RW_OUT" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
IOBUF PORT "TA_N" IO_TYPE=LVCMOS33 SLEWRATE=FAST ;
LOCATE COMP "CLK" SITE "128" ;
LOCATE COMP "RW_IN" SITE "75" ;
LOCATE COMP "RAM_CS_N" SITE "104" ;
LOCATE COMP "RAM_OE_N" SITE "94" ;
