LOCATE COMP "TA_N" SITE "95" ;
LOCATE COMP "RESET_PLL" SITE "76" ;
LOCATE COMP "LOCK_PLL" SITE "77" ;
USE PRIMARY NET "CLKOS" ;
USE PRIMARY NET "CLKOS2" ;
BANK 0 VCCIO 3.3 V;
BANK 1 VCCIO 3.3 V;
BANK 2 VCCIO 3.3 V;
BANK 3 VCCIO 3.3 V;
BANK 4 VCCIO 3.3 V;
BANK 5 VCCIO 3.3 V;
VCCIO_DERATE PERCENT 0; 
LOCATE COMP "A[23]" SITE "86" ;
LOCATE COMP "A[24]" SITE "87" ;
LOCATE COMP "A[25]" SITE "89" ;
LOCATE COMP "A[26]" SITE "91" ;
